              { text: 'PSNR ↑', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
              { text: 'SSIM ↑', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
              { text: 'LPIPS ↓', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
              { text: 'FPS ↑', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
            ],
            ['iMAP', 'RGB-D', '22.12', '0.752', '0.312', '<1'],
            ['NICE-SLAM', 'RGB-D', '24.65', '0.810', '0.235', '<1'],
            ['ESLAM', 'RGB-D', '28.41', '0.871', '0.148', '2'],
            ['Point-SLAM', 'RGB-D', '28.95', '0.887', '0.124', '3'],
            ['MonoGS', 'Mono', '32.80', '0.952', '0.055', '60'],
            ['GS-SLAM', 'RGB-D', '33.45', '0.958', '0.048', '90'],
            ['SplaTAM', 'RGB-D', '34.15', '0.965', '0.042', '100'],
            [
              { text: '本研究', textStyle: { bold: true, color: '#1E4FA8' } },
              { text: 'Mono', textStyle: { bold: true, color: '#1E4FA8' } },
              { text: '35.20', textStyle: { bold: true, color: '#1E4FA8' } },
              { text: '0.971', textStyle: { bold: true, color: '#1E4FA8' } },
              { text: '0.035', textStyle: { bold: true, color: '#1E4FA8' } },
              { text: '118', textStyle: { bold: true, color: '#1E4FA8' } },
            ],
          ]}
        />
      </Box>

      <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'space-between' }}>

        <Box style={{ flexDirection: 'column', paddingLeft: 22, borderLeft: '3px solid #1E4FA8' }}>
          <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 6 }}>
            <Text style={{ fontSize: 48, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>35.20</Text>
            <Text style={{ fontSize: 18, color: '#1E4FA8' }}>dB</Text>
          </Box>
          <Text style={{ fontSize: 16, color: '#4A5568', marginTop: 8, lineHeight: 1.45 }}>PSNR，高于所有 RGB-D 方法</Text>
        </Box>

        <Box style={{ flexDirection: 'column', paddingLeft: 22, borderLeft: '3px solid #3D7BD9' }}>
          <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 6 }}>
            <Text style={{ fontSize: 48, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>118</Text>
