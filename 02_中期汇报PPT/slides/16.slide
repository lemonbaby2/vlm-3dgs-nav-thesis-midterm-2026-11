        <Box style={{ flexDirection: 'column', paddingLeft: 22, borderLeft: '3px solid #3D7BD9' }}>
          <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 6 }}>
            <Text style={{ fontSize: 48, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>35.7</Text>
            <Text style={{ fontSize: 18, color: '#1E4FA8' }}>ms</Text>
          </Box>
          <Text style={{ fontSize: 16, color: '#4A5568', marginTop: 8, lineHeight: 1.45 }}>前端单帧跟踪耗时（28 Hz）</Text>
