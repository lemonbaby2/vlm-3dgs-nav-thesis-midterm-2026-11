      <Box style={{ width: 648, flexDirection: 'column' }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1A2230', marginBottom: 12 }}>表 2　Replica 数据集 3D 高斯地图渲染质量</Text>
        <Table
          style={{ width: 648, height: 396 }}
          defaultTextStyle={{ fontSize: 16, textAlign: 'center', color: '#1A2230' }}
          defaultCellStyle={{
            border: {
              left: { width: 0, color: '#FFFFFF' },
              right: { width: 0, color: '#FFFFFF' },
