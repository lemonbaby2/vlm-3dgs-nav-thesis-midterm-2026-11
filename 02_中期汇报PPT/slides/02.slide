<Slide style={{ width: 1280, height: 720, backgroundColor: '#FFFFFF', fontFamily: 'Microsoft YaHei', padding: 0 }}>
  <Box style={{ width: 1280, height: 720, paddingLeft: 120, paddingRight: 120, paddingTop: 120, paddingBottom: 100, flexDirection: 'row', gap: 96 }}>

    <Box style={{ width: 210, flexDirection: 'column', justifyContent: 'flex-start' }}>
      <Text style={{ fontSize: 48, fontWeight: 'bold', color: '#1A2230', lineHeight: 1.2 }}>目录</Text>
      <Text style={{ fontSize: 15, color: '#8B97A8', letterSpacing: 3, marginTop: 12 }}>CONTENTS</Text>
      <Box style={{ width: 54, height: 4, background: '#1E4FA8', marginTop: 32 }} />
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center' }}>
      {[
        { no: '01', name: '研究背景与科学问题', page: '04 — 07' },
        { no: '02', name: '研究内容与技术路线', page: '09 — 13' },
        { no: '03', name: '阶段性研究结果', page: '15 — 21' },
        { no: '04', name: '存在问题与下阶段计划', page: '23 — 24' },
      ].map((it, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', height: 98, borderBottom: '1px solid #D6DCE5' }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 30 }}>
            <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#1E4FA8', width: 56 }}>{it.no}</Text>
            <Text style={{ fontSize: 27, color: '#1A2230', fontWeight: 'bold' }}>{it.name}</Text>
          </Box>
          <Text style={{ fontSize: 16, color: '#8B97A8' }}>P {it.page}</Text>
        </Box>
      ))}
    </Box>

  </Box>
</Slide>
